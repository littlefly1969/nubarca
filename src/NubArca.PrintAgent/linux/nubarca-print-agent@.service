[Unit]
Description=NubArca Print Agent (%i)
# Not network-online.target: a Print Box with no known network must start
# anyway, because it is the agent that opens the Wi-Fi setup network. Every
# instance retries the server on its own.
After=network.target

[Service]
Type=notify
User=nubarca-print-%i
Group=nubarca-print-%i
WorkingDirectory=/opt/nubarca-print-agent
Environment=DOTNET_ENVIRONMENT=Production
ExecStart=/opt/nubarca-print-agent/NubArca.PrintAgent --config /etc/nubarca-print-agent/%i.json
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nubarca-print-agent/%i

[Install]
WantedBy=multi-user.target
