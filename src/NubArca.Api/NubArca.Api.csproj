<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <!-- NubArca release version; keep in sync with frontend/package.json. -->
    <Version>0.3.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Password-recovery email. MailKit is the maintained SMTP client for
         modern .NET (System.Net.Mail.SmtpClient is obsolete for new code and
         does not do modern TLS/authentication properly). Generic SMTP only —
         no provider SDK, so a self-hosted installation stays free of anyone
         else's service. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <!-- Slice 100: optional high-performance libvips derivative backend.
         NetVips is the managed binding; NetVips.Native.linux-x64 bundles a
         self-contained libvips (+ its image-codec deps) so no apt packages are
         needed on the glibc-based aspnet runtime image. When the native lib is
         unavailable (e.g. a non-linux-x64 box) the backend reports itself
         unavailable and the pipeline falls back to ImageSharp. -->
    <PackageReference Include="NetVips" Version="3.0.0" />
    <PackageReference Include="NetVips.Native.linux-x64" Version="8.15.3" />
    <!-- Phase 2A: local ONNX image-embedding evaluation harness (CPU runtime).
         Inference only runs when an ONNX model is configured + present on disk;
         the OnnxImageEmbedder reports itself unavailable otherwise, so this adds
         no runtime cost unless a model is wired. No model weights are committed
         (see .gitignore). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.1" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
    <!-- Loads the exact Hugging Face tokenizer.json shipped with SigLIP2.
         Semantic photo search must use the checkpoint tokenizer verbatim
         (lowercase + EOS + fixed 64-token padding/truncation); a hand-written
         approximation would silently degrade cross-modal retrieval quality. -->
    <PackageReference Include="Tokenizers.HuggingFace" Version="3.23.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test project exercises CLI command internals (EnsureUserAsync /
         DbMigrateAsync) so it can supply a SQLite-backed service provider
         instead of spinning a real Postgres for every assertion. -->
    <InternalsVisibleTo Include="NubArca.Api.Tests" />
  </ItemGroup>


  <!-- Brand material the print renderer draws with, LINKED to its canonical
       source rather than copied: a copy is a second thing to keep in sync, and
       the brand contract is that every served file is byte-identical to the
       package it came from. Nothing here resizes, recolours or redraws. -->
  <ItemGroup>
    <Content Include="..\..\assets\brand\nubarca\runtime\web\nubarca-wordmark-on-dark-960w.png"
             Link="Assets\brand\nubarca-wordmark-on-dark-960w.png"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\brand\nubarca\runtime\web\nubarca-wordmark-on-light-480w.png"
             Link="Assets\brand\nubarca-wordmark-on-light-480w.png"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- The approved product faces, from the manifested set whose hashes
         scripts/check-brand-invariants.py already verifies. -->
    <Content Include="..\..\mobile\assets\fonts\SpaceGrotesk-Bold.ttf"
             Link="Assets\fonts\SpaceGrotesk-Bold.ttf"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\mobile\assets\fonts\Exo2-Medium.ttf"
             Link="Assets\fonts\Exo2-Medium.ttf"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
