# react-native is aliased to react-native-tvos (a superset fork). npm's strict
# peer-dependency resolver rejects the prerelease-tagged fork version against
# packages that declare a `react-native` peer range, so TV/Expo installs require
# legacy peer-dep handling. This is the documented approach for Expo TV apps —
# NOT --force (which would also ignore genuine conflicts).
legacy-peer-deps=true
