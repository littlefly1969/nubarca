{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,
    // The shared @nubarca/contracts package spells its internal imports with
    // explicit .ts extensions, because the mobile and TV test runners load it
    // through Node's type stripping, which requires them. Permitting the form
    // here costs nothing (this project already emits nothing) and is what lets
    // one package serve a bundler and two Metro apps without a build step.
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@nubarca/api-client": ["./packages/api-client/src/index.ts"],
      "@nubarca/contracts": ["../packages/contracts/src/index.ts"]
    }
  },
  "include": ["src", "packages/api-client/src", "../packages/contracts/src"]
}
